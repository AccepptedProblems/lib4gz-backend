{
  "permittedEndpoints": [
    "/v1/auth/login",
    "/v1/auth/register",
    "/v2/api-docs",
    "/v3/api-docs",
    "/v3/api-docs/**",
    "/swagger-resources",
    "/swagger-resources/**",
    "/configuration/ui",
    "/configuration/security",
    "/swagger-ui/**",
    "/webjars/**",
    "/swagger-ui.html",
    "/error"
  ],
  "authorizedEndpoints": [
  ],
  "cors": {
    "allowedOriginPatterns": [
      "*"
    ],
    "allowedMethods": [
      "HEAD",
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH"
    ],
    "allowedHeaders": [
      "Origin",
      "Authorization",
      "Cache-Control",
      "Content-Type",
      "access_token"
    ],
    "allowCredentials": true,
    "maxAge": 3600
  }
}