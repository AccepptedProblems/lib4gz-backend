# Local secrets for bootRun / tests. Copy to .env and fill in; .env is git-ignored.
# Spring loads .env automatically (spring.config.import in application.yaml).
# Real environment variables win over this file. Cloud Run gets these from Secret Manager.

# Supabase Postgres
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# HMAC key (Base64) used to sign access tokens. Required.
JWT_SECRET_KEY=

# Who sends the one-time codes: log or brevo. Blank counts as log, which prints the mail and the
# code to the bootRun console instead of emailing it. Set brevo to send for real; it also needs
# MAIL_FROM_ADDRESS and BREVO_API_KEY, or the application refuses to start and says which is missing.
MAIL_PROVIDER=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# Brevo API key, from SMTP & API > API keys. Not the SMTP key, and not the SMTP login.
BREVO_API_KEY=

# Google OAuth Web client id (public value, needed for Google sign-in)
GOOGLE_CLIENT_ID=
