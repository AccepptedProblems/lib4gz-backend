              "raw": "{\n  \"questions\": [\n    {\n      \"content\": \"What is a variable?\",\n      \"orderIndex\": 0,\n      \"meta\": {\n        \"points\": 10\n      },\n      \"visibility\": \"VISIBLE\"\n    },\n    {\n      \"content\": \"Explain the difference between let and const.\",\n      \"orderIndex\": 1,\n      \"meta\": {\n        \"points\": 15\n      },\n      \"visibility\": \"VISIBLE\"\n    },\n    {\n      \"content\": \"What is a function?\",\n      \"orderIndex\": 2,\n      \"meta\": {\n        \"points\": 10\n      },\n      \"visibility\": \"VISIBLE\"\n    }\n  ]\n}"
